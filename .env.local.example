# ============================================================================
# Supabase (production database)
# Get these from: Supabase Dashboard -> Project Settings -> API
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...your-service-role-key

# ============================================================================
# Admin gate. Authorized users live in the `admin_users` table (email +
# scrypt-hashed password). The default seeded login (from supabase/schema.sql)
# is:  email: test@gmail.com   password: test
# Add or rotate users with: npm run seed-admin -- <email> <password>
#
# SESSION_SECRET signs the admin session cookies. It is OPTIONAL: if you do not
# set it, the app falls back to SUPABASE_SERVICE_ROLE_KEY (already required
# above) as the signing key — handy when you cannot add a new env var on the
# host. For best practice, set a dedicated value (>=16 chars). Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it (or the service-role key, when falling back) invalidates sessions.
# ============================================================================
SESSION_SECRET=optional-long-random-string-min-16-chars

# ============================================================================
# Brand + base URL
# ============================================================================
NEXT_PUBLIC_BASE_URL=https://binkis.xyz
NEXT_PUBLIC_BRAND_NAME=BinKis
NEXT_PUBLIC_COLLECTION_NUMBER=777

# ============================================================================
# OPTIONAL: Google OAuth Client ID for "Sign in with Google" in subscribe modal
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized JS origins should include http://localhost:3002 and your Vercel URL
# ============================================================================
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ============================================================================
# LEGACY: Google Sheets credentials (only needed if running migrate-sheets script)
# Safe to remove after migration is complete.
# ============================================================================
GOOGLE_SHEETS_ID=your-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_TAB=Codes
