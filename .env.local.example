# ============================================================================
# Supabase (production database)
# Get these from: Supabase Dashboard -> Project Settings -> API
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...your-service-role-key

# ============================================================================
# Admin gate. Authorized users live in the `admin_users` table (email +
# scrypt-hashed password). Add or rotate users with:
#   npm run seed-admin -- <email> <password>
#
# SESSION_SECRET signs the admin session cookies. REQUIRED, at least 32 chars,
# and never the service-role key. Changing it logs every admin out. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ============================================================================
SESSION_SECRET=

# ============================================================================
# Loyalty (Binkicoins) and Shopify
# SHOPIFY_WEBHOOK_SECRET  shown under Settings > Notifications > Webhooks
# SHOPIFY_API_SECRET      client secret of the app that owns the App Proxy
# LOYALTY_API_KEY         server-to-server key for /api/loyalty/status (>=32)
# LOYALTY_COLLECTION_SKUS comma list of complete-collection SKUs (13 points)
# LOYALTY_PIECE_SKU_PREFIXES optional; if set, only these SKUs earn 1 point
# ============================================================================
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_SECRET=
LOYALTY_API_KEY=
LOYALTY_COLLECTION_SKUS=
LOYALTY_PIECE_SKU_PREFIXES=

# ============================================================================
# Brand + base URL
# ============================================================================
NEXT_PUBLIC_BASE_URL=https://binkis.xyz
NEXT_PUBLIC_BRAND_NAME=BinKis
NEXT_PUBLIC_COLLECTION_NUMBER=777

# ============================================================================
# OPTIONAL: Google OAuth Client ID for "Sign in with Google" in subscribe modal
# Create at: https://console.cloud.google.com/apis/credentials
# Authorized JS origins should include http://localhost:3002 and your Vercel URL
# ============================================================================
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ============================================================================
# LEGACY: Google Sheets credentials (only needed if running migrate-sheets script)
# Safe to remove after migration is complete.
# ============================================================================
GOOGLE_SHEETS_ID=your-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_TAB=Codes
